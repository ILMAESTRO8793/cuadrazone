# Copia este archivo como .env para desarrollo local. En Railway, define estas
# variables en el servicio (Variables). Nunca subas el .env real a Git.

# Conexión MySQL. En Railway: ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://usuario:clave@localhost:3306/cuadrazone

# Secreto para firmar sesiones: mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Dirección pública del sitio, sin barra final.
PUBLIC_URL=http://localhost:3000

# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web)
# URI de redirección autorizado: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos de Google con rol de administrador, separados por comas.
ADMIN_EMAILS=

# Carpeta persistente de fotos del catálogo. En Railway, monta un volumen en /data.
STORAGE_DIR=./storage

# Datos de pago de CuadraZone que ven los vendedores en "Mi tienda" para pagar la
# mensualidad y la comisión. Cada forma de pago aparece solo si está completa.
# Yappy: número o nombre en el directorio, y a nombre de quién aparece (opcional).
PAYMENT_YAPPY=
PAYMENT_YAPPY_NAME=
# Transferencia: banco, número de cuenta y titular (los tres); tipo opcional (Ahorros/Corriente).
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_HOLDER=
PAYMENT_BANK_ACCOUNT_TYPE=
# Tarjeta de crédito o débito: enlace https de cobro de la pasarela (Tilopay,
# PagueloFácil…). El vendedor paga en la página de la pasarela; CuadraZone no ve la tarjeta.
PAYMENT_CARD_URL=
# Opcional: WhatsApp para dudas sobre pagos. Ej.: +507 6000-0000
PAYMENT_CONTACT=

# Correos automáticos con Brevo (Railway no permite SMTP en el plan Hobby).
# Sin estas variables el sitio funciona igual, pero no envía correos.
BREVO_API_KEY=
# Remitente verificado en Brevo, p. ej. avisos@tudominio.com
EMAIL_FROM=
EMAIL_FROM_NAME=CuadraZone

# SMS para entrar con el celular y verificar teléfonos.
# Opción gratis: un celular Android con la app «SMS Gateway for Android» (sms-gate.app)
# en modo nube; usuario y contraseña aparecen en la pantalla principal de la app.
SMS_PROVIDER=gateway
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
# Opción Twilio (de pago): SMS_PROVIDER=twilio y estas tres
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
